{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noevia:egress-control:operation-bodies:1",
  "title": "Noevia egress control operation bodies v1",
  "$comment": "Top-level oneOf describes request bodies only. Raw UTF-8 JSON <=32768 bytes; duplicate fields rejected. Schema cannot enforce duplicate keys, numeric lexical spelling, metadata MAC binding, HTTP framing, deadline freshness or live state. HTTP/1.1 POST exact origin path; single Host, exact application/json and canonical matching Content-Length; x-noevia-request-id, x-noevia-deadline-ms, x-noevia-key-fingerprint, x-noevia-control-mac, optional x-noevia-boot-id. Optional Connection close/keep-alive, User-Agent, Accept only; all duplicate/other headers refuse;16 headers/16KiB. Initial Ready requires absent boot/null prior; replacement requires known boot and exact runtime prior session. Response defs:200ready/renewed,202pending,409conflict,408stale,503uncertain/unavailable/drain-incomplete. Response MAC binds original request MAC/status/exact bytes <=64KiB, no-store/close. Buffered controller implements Ready/renew only; scoped activity/revoke/forget are explicit503 until implemented. No live listener, permission-safe key-file adapter, transport collection/time/concurrency/parser qualification, forwarding/idle policy integration or release qualification follows.",
  "oneOf": [
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/renew"
    },
    {
      "$ref": "#/$defs/activity"
    },
    {
      "$ref": "#/$defs/revoke"
    },
    {
      "$ref": "#/$defs/forget"
    }
  ],
  "$defs": {
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "challenge",
        "expectedKeyFingerprint",
        "priorSession"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "initial",
            "replace"
          ]
        },
        "challenge": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "expectedKeyFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "priorSession": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
              "minLength": 32,
              "maxLength": 32
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "initial"
              }
            }
          },
          "then": {
            "properties": {
              "priorSession": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "renew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sessionId",
        "sequence"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sessionId",
        "taskId",
        "leaseNonce",
        "signedGrant"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        },
        "leaseNonce": {
          "type": "string",
          "minLength": 22,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$(?![\\s\\S])"
        },
        "signedGrant": {
          "type": "string",
          "minLength": 50,
          "maxLength": 8192,
          "pattern": "^ngr1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])",
          "description": "Syntax only. Native execution must verify MAC, epoch, action, identities and claims."
        }
      }
    },
    "revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sessionId",
        "taskId",
        "leaseNonce",
        "grantIssuedAt",
        "signedGrant",
        "signedRevoke"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        },
        "leaseNonce": {
          "type": "string",
          "minLength": 22,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$(?![\\s\\S])"
        },
        "grantIssuedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "signedGrant": {
          "type": "string",
          "minLength": 50,
          "maxLength": 8192,
          "pattern": "^ngr1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])",
          "description": "Syntax only. Native execution must verify MAC, epoch, action, identities and claims."
        },
        "signedRevoke": {
          "type": "string",
          "minLength": 50,
          "maxLength": 8192,
          "pattern": "^ngr1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])",
          "description": "Syntax only. Native execution must verify MAC, epoch, action, identities and claims."
        }
      }
    },
    "forget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sessionId",
        "taskId",
        "leaseNonce",
        "snapshotId"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        },
        "leaseNonce": {
          "type": "string",
          "minLength": 22,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$(?![\\s\\S])"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        }
      }
    },
    "responseReady": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requestId",
        "state",
        "capability",
        "bootId",
        "sessionId",
        "keyFingerprint",
        "sequence",
        "leaseMs",
        "challenge"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "state": {
          "const": "ready"
        },
        "capability": {
          "const": "noevia-code-egress-control/1"
        },
        "bootId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "keyFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "sequence": {
          "const": 0
        },
        "leaseMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15000
        },
        "challenge": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        }
      }
    },
    "responseRenew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requestId",
        "state",
        "capability",
        "bootId",
        "sessionId",
        "keyFingerprint",
        "sequence",
        "leaseMs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "state": {
          "const": "renewed"
        },
        "capability": {
          "const": "noevia-code-egress-control/1"
        },
        "bootId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "keyFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15000
        }
      }
    },
    "responseTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requestId",
        "state"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
          "minLength": 32,
          "maxLength": 32
        },
        "state": {
          "enum": [
            "pending",
            "uncertain",
            "unavailable",
            "conflict",
            "drain-incomplete",
            "stale"
          ]
        }
      }
    }
  }
}
