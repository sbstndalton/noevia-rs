{
  "version": 1,
  "source": "Hand-derived from noevia-core server/llamacpp-full-autotune.cjs start() lines 1604-1622 and MODES (lines 19-20). NOT recorded by running Node: the F4 recording (R6.md section 4b) is still to do. Inputs use the body keys Node reads; an absent key is left out of input, null is written as null.",
  "cases": [
    { "name": "fast default", "input": { "confirmPause": true }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 120 } } },
    { "name": "long default", "input": { "confirmPause": true, "mode": "long" }, "expect": { "ok": { "mode": "long", "promptBudgetSeconds": 1800 } } },
    { "name": "fast minimum 15", "input": { "confirmPause": true, "promptBudgetSeconds": 15 }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 15 } } },
    { "name": "fast maximum 1800", "input": { "confirmPause": true, "promptBudgetSeconds": 1800 }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 1800 } } },
    { "name": "null seconds uses mode default", "input": { "confirmPause": true, "mode": "fast", "promptBudgetSeconds": null }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 120 } } },
    { "name": "numeric string seconds", "input": { "confirmPause": true, "promptBudgetSeconds": "120" }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 120 } } },
    { "name": "hex string seconds (Number coercion)", "input": { "confirmPause": true, "promptBudgetSeconds": "0x78" }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 120 } } },
    { "name": "single system model not bulk, not running", "input": { "confirmPause": true, "systemModel": false }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 120 } } },
    { "name": "bulk with system model is allowed", "input": { "confirmPause": true, "bulk": true, "systemModel": true }, "expect": { "ok": { "mode": "fast", "promptBudgetSeconds": 120 } } },

    { "name": "confirm absent", "input": {}, "expect": { "refuse": { "status": 400, "message": "Confirm that chat can pause and other model-server clients are stopped." } } },
    { "name": "confirm string true is not true", "input": { "confirmPause": "true" }, "expect": { "refuse": { "status": 400, "message": "Confirm that chat can pause and other model-server clients are stopped." } } },
    { "name": "confirm false beats a bad mode", "input": { "confirmPause": false, "mode": "turbo" }, "expect": { "refuse": { "status": 400, "message": "Confirm that chat can pause and other model-server clients are stopped." } } },
    { "name": "mode null is present, not default", "input": { "confirmPause": true, "mode": null }, "expect": { "refuse": { "status": 400, "message": "Choose Fast or Long." } } },
    { "name": "mode unknown", "input": { "confirmPause": true, "mode": "turbo" }, "expect": { "refuse": { "status": 400, "message": "Choose Fast or Long." } } },
    { "name": "mode case differs", "input": { "confirmPause": true, "mode": "Fast" }, "expect": { "refuse": { "status": 400, "message": "Choose Fast or Long." } } },
    { "name": "long with bulk", "input": { "confirmPause": true, "mode": "long", "bulk": true, "promptBudgetSeconds": 5 }, "expect": { "refuse": { "status": 400, "message": "A Long tune runs for one model at a time. Choose a model." } } },
    { "name": "seconds 14 below range", "input": { "confirmPause": true, "promptBudgetSeconds": 14 }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },
    { "name": "seconds 1801 above range", "input": { "confirmPause": true, "promptBudgetSeconds": 1801 }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },
    { "name": "seconds fractional", "input": { "confirmPause": true, "promptBudgetSeconds": 120.5 }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },
    { "name": "seconds non-numeric string", "input": { "confirmPause": true, "promptBudgetSeconds": "soon" }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },
    { "name": "seconds empty string is Number 0", "input": { "confirmPause": true, "promptBudgetSeconds": "" }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },
    { "name": "seconds true is Number 1", "input": { "confirmPause": true, "promptBudgetSeconds": true }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },
    { "name": "seconds array refused (JS would coerce a one-element array; not modelled)", "input": { "confirmPause": true, "promptBudgetSeconds": [120] }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },

    { "name": "running refused", "input": { "confirmPause": true, "runActive": true }, "expect": { "refuse": { "status": 409, "message": "Auto-tune is already running." } } },
    { "name": "limit checked before running", "input": { "confirmPause": true, "runActive": true, "promptBudgetSeconds": 5 }, "expect": { "refuse": { "status": 400, "message": "Choose a prompt time limit between 15 and 1800 seconds." } } },
    { "name": "single system model refused", "input": { "confirmPause": true, "systemModel": true }, "expect": { "refuse": { "status": 400, "message": "System routing model — not tuned" } } },
    { "name": "running beats system model", "input": { "confirmPause": true, "runActive": true, "systemModel": true }, "expect": { "refuse": { "status": 409, "message": "Auto-tune is already running." } } },
    { "name": "long with bulk beats the limit", "input": { "confirmPause": true, "mode": "long", "bulk": true, "promptBudgetSeconds": 5, "runActive": true }, "expect": { "refuse": { "status": 400, "message": "A Long tune runs for one model at a time. Choose a model." } } }
  ]
}
