      "op": "plan",
      "tool": "drive_create_file",
      "args": {
        "name": "  notes.md \n",
        "content": "x"
      },
      "expect": {
        "target": "notes.md",
        "kind": "drive-new"
      }
    },
    {
      "op": "plan",
      "tool": "drive_create_file",
      "args": {
        "name": "   ",
        "content": "x"
      },
      "expect": {
        "kind": "null"
      }
    },
    {
      "op": "plan",
      "tool": "drive_create_file",
      "args": {
        "name": 42,
        "content": "x"
      },
      "expect": {
        "kind": "null"
      }
    },
    {
      "op": "plan",
      "tool": "drive_create_file",
      "args": {
        "name": "",
        "content": "x"
      },
      "expect": {
        "target": "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn",
